{
    "name": "api-gateway",
    "version": "1.0.0",
    "description": "API Gateway para el proyecto de chat (Distribuidas/Seguridad)",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "nodemon index.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "http-proxy-middleware": "^2.0.6",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "jest": "^30.2.0",
        "nodemon": "^2.0.22",
        "supertest": "^7.1.4"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.js"
        ]
    }
}
